    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Extract structured data from the message.\n\nReturn ONLY valid JSON:\n\n{\n  \"intent\": \"save | query | unknown\",\n  \"category\": \"string\",\n  \"subject\": \"string or null\",\n  \"amount\": \"number or null\",\n  \"time\": \"string or null\",\n  \"note\": \"string or null\"\n}\n\nSTRICT RULES:\n\n1. Financial meaning:\n- \"owe\", \"borrowed\", \"took\" → intent = \"save\" (user owes someone)\n- \"paid\", \"gave\", \"sent\" → intent = \"save\" (user paid someone)\n- Questions → intent = \"query\"\n\n2. Subject extraction:\n- Subject MUST be the PERSON involved (e.g. \"Abex\")\n- NOT objects like \"dress\", \"food\", etc.\n\n3. Notes:\n- Extra context goes into \"note\"\n\n4. If unsure → intent = \"unknown\"\n\n5. DO NOT output markdown or code blocks\n\n---\n\nMessage:\n\"{{ $json.message.text }}\"",
        "needsFallback": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -32,
        -1152
      ],
      "id": "9ca9a0de-aad0-4c85-9493-edf90395e08b",
      "name": "AI NLP",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.message.text.toLowerCase();\n\nconst queryWords = [\"how\", \"what\", \"when\", \"who\", \"where\", \"show\", \"can\"];\nconst saveWords = [\"owe\", \"paid\", \"borrowed\", \"gave\", \"sent\", \"took\"];\n\nconst hasQuestionMark = text.includes(\"?\");\nconst hasQueryWord = queryWords.some(w => text.includes(w));\nconst hasSaveWord = saveWords.some(w => text.includes(w));\n\nreturn [{\n  text,\n  isQuestion: hasQuestionMark || hasQueryWord,\n  isSaveHint: hasSaveWord\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -1472
      ],
      "id": "acfefd9e-0850-46e9-9956-c288a3db32cc",
      "name": "Intent Check Fallback"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst intent = input.intent;\nconst isQuestion = input.isQuestion;\nconst isSaveHint = input.isSaveHint;\n\nlet finalIntent = intent;\n\n// fallback\nif (!intent || intent === \"unknown\") {\n  if (isQuestion) {\n    finalIntent = \"query\";\n  } else if (isSaveHint) {\n    finalIntent = \"save\";\n  } else {\n    finalIntent = \"unknown\";\n  }\n}\n\nreturn [{\n  ...input,\n  finalIntent\n}];"
      },
