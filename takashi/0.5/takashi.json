      "parameters": {
        "jsCode": "let amount = $json.amount || 0;\nconst text = ($json.text || \"\").toLowerCase();\n\n// payment → negative\nif (\n  text.includes(\"paid\") ||\n  text.includes(\"gave\") ||\n  text.includes(\"sent\") ||\n  text.includes(\"returned\")\n) {\n  amount = -Math.abs(amount);\n}\n\n// owe → positive\nif (\n  text.includes(\"owe\") ||\n  text.includes(\"borrowed\") ||\n  text.includes(\"took\")\n) {\n  amount = Math.abs(amount);\n}\n\nreturn [{\n  ...$json,\n  amount\n}];"
      },
