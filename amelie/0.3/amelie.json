    {
      "parameters": {
        "jsCode": "const releases = [];\nconst digests = [];\nconst upcoming = [];\n\nfor (const item of items) {\n  const title = item.json.title || '';\n  const lower = title.toLowerCase();\n\n  if (lower.includes('upcoming repacks')) {\n\n    const html =\n      item.json['content:encoded'] ||\n      item.json.content ||\n      item.json.description ||\n      '';\n\n    const games = [...html.matchAll(/⇢\\s*([^<\\n\\r]+)/g)]\n      .map(m => m[1].trim());\n\n    if (games.length) {\n      upcoming.push(games.map(g => `• ${g}`).join('\\n'));\n    } else {\n      upcoming.push(`• ${title}\\n${item.json.link}`);\n    }\n\n  } else if (lower.includes('updates digest')) {\n\n    digests.push(`• ${title}\\n${item.json.link}`);\n\n  } else {\n\n    releases.push(`• ${title}\\n${item.json.link}`);\n\n  }\n}\n\nlet message = '📋 FITGIRL DAILY SUMMARY\\n━━━━━━━━━━━━━━\\n\\n';\n\nif (releases.length) {\n  message += '🎮 New Releases\\n\\n';\n  message += releases.join('\\n\\n');\n  message += '\\n\\n';\n}\n\nif (digests.length) {\n  message += '🔄 Updates Digest\\n\\n';\n  message += digests.join('\\n\\n');\n  message += '\\n\\n';\n}\n\nif (upcoming.length) {\n  message += '📋 Upcoming Repacks\\n\\n';\n  message += upcoming.join('\\n');\n}\n\nreturn [\n  {\n    json: {\n      message\n    }\n  }\n];"
      },
